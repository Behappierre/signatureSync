{
  "name": "signature-sync",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted email signature extractor. Static React app plus one Netlify Function, with Google Sheets as the datastore.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.mjs",
    "lint": "eslint src netlify --ext .ts,.tsx,.mts"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.1",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.3",
    "vite": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Behappierre/signatureSync.git"
  },
  "keywords": [
    "email-signature",
    "google-sheets",
    "netlify",
    "react",
    "typescript"
  ]
}
