# ---------------------------------------------------------------------------
# Browser configuration. These are compiled into the bundle and are PUBLIC.
# Never put a secret in a VITE_ variable.
# ---------------------------------------------------------------------------

# OAuth 2.0 Web application client ID from the Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=""

# API key restricted to the Picker API. Needed only to choose an existing
# spreadsheet from Drive; creating a new sheet works without it.
VITE_GOOGLE_API_KEY=""

# Google Cloud project number. Optional, improves Picker behaviour.
VITE_GOOGLE_APP_ID=""

# Override the OAuth scopes. The default keeps the app on drive.file, which
# only ever grants access to sheets the user creates here or picks explicitly.
# VITE_GOOGLE_SCOPES="https://www.googleapis.com/auth/spreadsheets https://www.googleapis.com/auth/userinfo.email"

# ---------------------------------------------------------------------------
# Server-side, used only by the extract function. These are SECRET.
# Set them in the Netlify UI, never in a committed file.
# ---------------------------------------------------------------------------

# Set ONE of these three. If more than one is set, the first in this order
# wins: OpenRouter, Anthropic, OpenAI.
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""

# Optional model overrides.
# OpenRouter gives you one key for many models, so switching model is a change
# to this variable alone. Pin a dated version rather than a -latest alias so a
# provider-side update cannot change behaviour under you.
# OPENROUTER_MODEL="deepseek/deepseek-v4-flash-0731"
# ANTHROPIC_MODEL="claude-sonnet-4-5"
# OPENAI_MODEL="gpt-4o-mini"

# Optional OpenRouter attribution, shown on their dashboard and rankings.
# OPENROUTER_SITE_URL="https://your-site.netlify.app"
# OPENROUTER_APP_NAME="SignatureSync"

# The same client ID as above, used to verify that callers of the extract
# endpoint are signed in to this app.
GOOGLE_CLIENT_ID=""

# Optional. Comma-separated list restricting who may call the extract
# endpoint. Leave empty to allow any signed-in Google account.
# ALLOWED_EMAILS="you@example.com"
